# Public (safe for the browser; also set as Workers Build vars so Next can inline them)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only (Workers → Settings → Variables and Secrets)
SUPABASE_SECRET_KEY=
CRON_SECRET=
IP_HASH_SALT=
APP_URL=https://mburoja.YOUR_SUBDOMAIN.workers.dev
SIMULATE_EMAIL=true
EXTENSION_ORIGINS=

# Optional LLM explainers
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
